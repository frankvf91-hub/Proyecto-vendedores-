rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signed(){ return request.auth != null; }
  function admin(){ return signed() && request.auth.uid == 'Tr47zBMSA0cMuYYU4mjPaVRr2S02'; }
  match /clientes/{id} { allow read: if admin() || (signed() && resource.data.ownerUid == request.auth.uid); allow create: if signed() && request.resource.data.ownerUid == request.auth.uid; allow update, delete: if admin() || (signed() && resource.data.ownerUid == request.auth.uid); }
  match /usuarios/{uid} { allow read, create, update: if signed() && request.auth.uid == uid; }
  match /pushTokens/{id} { allow read, create, update: if signed() && request.resource.data.uid == request.auth.uid; allow delete: if signed() && resource.data.uid == request.auth.uid; }
  match /notificationDaily/{id} { allow read, write: if false; }
}}
